{
  "name": "@freecorps/mail-sdk",
  "version": "0.1.1",
  "description": "Typed client for Ember Mail (freecorps/mail), a Resend-style email API on Cloudflare: send, batch, status, list, waitFor, domains, API keys, templates, suppressions, inbox. No dependencies; safe retries with idempotency keys.",
  "keywords": [
    "email",
    "resend",
    "cloudflare",
    "sdk",
    "inbox",
    "freecorps-mail"
  ],
  "homepage": "https://github.com/freecorps/mail/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/freecorps/mail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/mail.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@freecorps/ember-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
