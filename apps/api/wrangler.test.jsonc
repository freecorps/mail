// Test-only Worker config for @cloudflare/vitest-plugin. Never deployed (ember deploy builds the real one).
{
  "name": "ember-mail-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SHARD", "class_name": "Shard" },
      { "name": "SYSTEM", "class_name": "System" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Shard", "System"] }],
  "r2_buckets": [{ "binding": "EMBER_FILES", "bucket_name": "ember-mail-test-files" }],
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [{ "binding": "EMBER_Q_EMAIL_EVENTS", "queue": "ember-mail-test-email-events" }],
    "consumers": [{ "queue": "ember-mail-test-email-events", "max_batch_timeout": 0, "max_retries": 3, "retry_delay": 0 }]
  }
}
